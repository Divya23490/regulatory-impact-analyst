# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Model id used by all three frameworks (LangGraph/Deep Agents via the native
# Gemini SDK, AutoGen via Gemini's OpenAI-compatible endpoint).
REGIMPACT_MODEL=gemini-3.5-flash-lite

# Optional: real web search for the Deep Agent's research tool.
# Without this it falls back to a labelled stub and reasons from the
# regulation text + policy register alone.
# TAVILY_API_KEY=tvly-...

# Optional: LangSmith tracing (nice for the "auditability" story in a bank demo)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=regimpact
